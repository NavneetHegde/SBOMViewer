@using System.Text.Json
@using SBOMViewer.Blazor.Models
@inject SbomState SbomState
@inject SbomLoader SbomLoader
@inject ChatState ChatState
@inject RecentSbomStore RecentStore
@inject NavigationManager Nav
@inject HttpClient Http

<div class="upload-screen">
    <div class="upload-grid"></div>

    <div class="upload-hero fadein">
        <h1>Inspect your <span>SBOM</span><br />in seconds.</h1>
        @* "explored entirely in your browser" implied the vulnerability scan was local too. It
           isn't — it queries OSV.dev. What is unconditionally true is that the file never leaves. *@
        <p>Vulnerabilities, licenses, and dependencies — your SBOM file is never uploaded.</p>
    </div>

    @* Quick-start row. It sits ABOVE the two cards so the sample and the recent files are in view
       without scrolling, however tall the cards get. It is also outside .dropzone on purpose:
       the InputFile overlay covers that whole area and would swallow the clicks. *@
    <div class="quick-row fadein" style="animation-delay:0.06s;">
        <button class="sample-link" @onclick="LoadSample" disabled="@_isLoading"
                title="Open a demo SBOM — nothing is stored or uploaded">
            <span class="sample-link-icon">▶</span>
            <span class="sample-link-text">
                <span class="sample-link-hint">No SBOM handy?</span>
                <span class="sample-link-label">Try a sample →</span>
            </span>
        </button>

        @if (_recent.Count > 0)
        {
            <div class="recent-bar">
                <span class="recent-bar-title" title="Kept in this browser only — never uploaded anywhere.">Recent</span>
                <div class="recent-list">
                    @foreach (var item in _recent)
                    {
                        <button class="recent-item" @onclick="() => OpenRecent(item)"
                                title="@($"{item.Name} — {item.Format} · {item.SizeLabel} · kept in this browser only")">
                            <span class="recent-item-name">@item.Name</span>
                            <span class="recent-item-meta">@item.Format · @item.SavedAgo(DateTimeOffset.Now)</span>
                        </button>
                    }
                </div>
                <button class="recent-clear" @onclick="ClearRecent" title="Forget the files stored in this browser">Clear</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="upload-error fadein">⚠ @_errorMessage</div>
    }

    <div class="upload-options">
        <div class="dropzone @(_drag ? "dragover" : "") fadein"
             style="animation-delay:0.1s; position:relative;"
             @ondragenter="OnDragEnter"
             @ondragleave="OnDragLeave"
             @ondragover:preventDefault="true"
             @ondrop="OnDrop">

            <!-- InputFile covers entire dropzone — handles both click-to-browse and drag-and-drop -->
            <InputFile style="position:absolute; inset:0; opacity:0; cursor:pointer; z-index:2; width:100%; height:100%; outline:none;"
                       accept=".json"
                       OnChange="OnFileChanged" />

            <!-- Visual content -->
            <div style="position:relative; z-index:1; pointer-events:none; display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; width:100%;">
                <div class="dropzone-icon">📄</div>
                <h3>Inspect one SBOM</h3>
                <p>Drop a file here, or click to browse</p>
                <div class="dropzone-formats">
                    @foreach (var version in SbomFormatDetector.SupportedVersions)
                    {
                        <span class="format-chip">@version</span>
                    }
                    <span class="format-chip">JSON</span>
                </div>
            </div>
        </div>

        <a class="compare-card fadein" href="compare" style="animation-delay:0.16s;">
            <div class="dropzone-icon">⇄</div>
            <h3>Compare two SBOMs</h3>
            <p>See what changed between two releases</p>
            <ul class="compare-card-points">
                <li>Components added &amp; removed</li>
                <li>Version bumps</li>
                <li>New license risk</li>
                <li>Works across formats</li>
            </ul>
            <span class="compare-card-btn">Compare →</span>
        </a>
    </div>

    @if (_isLoading)
    {
        <div style="position:fixed; top:0; left:0; right:0; bottom:0; background:oklch(11% 0.018 240 / 0.85); display:flex; flex-direction:column; justify-content:center; align-items:center; gap:16px; z-index:1000;">
            <div class="spinner" style="width:32px; height:32px; border-width:3px;"></div>
            <span style="color:var(--text-dim); font-size:13px;">Parsing SBOM…</span>
        </div>
    }
</div>

@code {
    private bool _isLoading;
    private string? _errorMessage;
    private int _dragCounter;

    private IReadOnlyList<RecentSbom> _recent = [];

    private bool _drag => _dragCounter > 0;

    private const string SampleFileName = "demo-storefront.cdx.json";

    protected override async Task OnInitializedAsync()
    {
        // Started, not awaited: the recents list and the deep link are independent, and a slow or
        // stalled IndexedDB must not hold the demo back behind a list the viewer then replaces.
        var recent = RefreshRecent();

        // Deep link: /?sample=1 opens the demo directly, so the README and social posts can link
        // straight into a loaded dashboard.
        if (SbomState.Document is null && IsSampleDeepLink())
        {
            // Strip the parameter first — otherwise "New file" would land back on a URL that
            // immediately reloads the sample. Only "sample" goes: campaign parameters and the
            // fragment on a shared link are kept.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("sample", (string?)null), replace: true);
            await LoadSample();
        }

        await recent;
    }

    private bool IsSampleDeepLink() =>
        System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["sample"] == "1";

    private async Task RefreshRecent() => _recent = await RecentStore.ListAsync();

    private void Show(SbomLoadResult result, bool isSample = false)
    {
        ChatState.ClearVulnerabilities();
        SbomState.Load(result, isSample);
    }

    private async Task LoadSample()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // The registered HttpClient has no BaseAddress, so a relative URL would throw.
            var url  = new Uri(new Uri(Nav.BaseUri), $"samples/{SampleFileName}");
            var json = await Http.GetStringAsync(url);

            // Load(string, string) does not save to the recents store — a demo file must not
            // evict one of the user's two real recents.
            var result = SbomLoader.Load(json, SampleFileName);
            if (!result.Success)
            {
                _errorMessage = result.Error;
                return;
            }

            Show(result, isSample: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _errorMessage = "Couldn't load the sample. Check your connection and try again.";
        }
        catch (Exception)
        {
            // Deliberately broad. On the deep-link path this runs inside OnInitializedAsync, where
            // anything that escapes takes the whole page down to the Blazor error UI.
            _errorMessage = "Couldn't load the sample. Please try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenRecent(RecentSbom item)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var content = await RecentStore.GetContentAsync(item.Id);
            if (content is null)
            {
                // The entry was evicted or the store became unreachable — drop it from the list.
                _errorMessage = "That file is no longer available in this browser.";
                await RefreshRecent();
                return;
            }

            var result = SbomLoader.Load(content, item.Name);
            if (!result.Success)
            {
                _errorMessage = result.Error;
                return;
            }

            Show(result);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearRecent()
    {
        await RecentStore.ClearAsync();
        await RefreshRecent();
    }

    private void OnDragEnter() => _dragCounter++;
    private void OnDragLeave() { _dragCounter = Math.Max(0, _dragCounter - 1); }
    private void OnDrop() => _dragCounter = 0;

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isLoading = true;
        _errorMessage = null;
        _dragCounter = 0;
        ChatState.ClearVulnerabilities();
        StateHasChanged();

        try
        {
            var result = await SbomLoader.LoadAsync(file);

            if (!result.Success)
            {
                _errorMessage = result.Error;
                SbomState.Clear();
                return;
            }

            Show(result);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
